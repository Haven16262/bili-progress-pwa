# 服务端口 (可选，默认 3000)
PORT=3000

# 应用登录密码 (必填)
APP_PASSWORD=your-password-here

# JWT 签名密钥 (必填，同时用于 SESSDATA 加密)
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  轮换 JWT_SECRET 会静默毁掉所有已存储的加密 SESSDATA——
#     crypto.js 用 JWT_SECRET 派生 AES-256-GCM 密钥，轮换后旧密文无法解密。
#     如需轮换：先导出 SESSDATA 明文 → 轮换密钥 → 重新加密写入。
JWT_SECRET=your-jwt-secret-here
